# the jev options are registered with their defaults and listed on the Shift+O sheet
assert-expr vd.options.jev_model == 'typesafe/jev-1.14'
assert-expr vd.options.jev_api_url == 'https://openrouter.ai/api/v1/systemone'
assert-expr vd.options.jev_concurrency == 8
assert-expr vd.options.jev_confirm_rows == 100
assert-expr vd.options.jev_timeout == 30
options-global
assert-expr {'jev_model', 'jev_api_url', 'jev_concurrency', 'jev_confirm_rows', 'jev_timeout'} <= {r.name for r in sheet.rows}
